# Kerb extension: simulated TEE on the real Coston2 chain (chain_id 114).
#
# This file is the tracked template. Copy it to .env.local.coston2 (which is
# gitignored because it holds a private key) and fill the three values marked
# FILL ME. Then activate it with:
#
#   bash ./scripts/use-chain.sh local coston2 typescript
#
# use-chain.sh copies the activated file over .env, which every other script
# sources. Re-run it after any edit here, otherwise .env keeps the old values.

# --- Keys -------------------------------------------------------------------
# FILL ME: Coston2 key funded from https://faucet.flare.network/coston2, hex,
# no 0x prefix. It pays for the contract deploy, the extension registration and
# the TEE registration fees.
DEPLOYMENT_PRIVATE_KEY=

# FILL ME: the address derived from DEPLOYMENT_PRIVATE_KEY. It becomes the
# extension owner and, by default, the sole TEE governance signer, so a value
# that does not match the key makes post-build fail with InvalidGovernanceHash.
INITIAL_OWNER=""

# Only read by the --local Go-process mode. The Docker path falls back to the
# public Hardhat development key set in docker-compose.yaml.
PROXY_PRIVATE_KEY=

# --- Chain ------------------------------------------------------------------
CHAIN=coston2
CHAIN_URL=https://coston2-api.flare.network/ext/C/rpc
ADDRESSES_FILE=./config/coston2/deployed-addresses.json

# LOCAL_MODE=false keeps the real attestation path against Coston2.
# SIMULATED_TEE=true pairs with MODE=1 (injected by docker-compose) so the
# stack runs without Confidential VM hardware. Both are the documented
# combination for Coston2 development.
LOCAL_MODE=false
SIMULATED_TEE=true

# --- Proxies ----------------------------------------------------------------
NORMAL_PROXY_URL=https://tee-proxy-coston2-1.flare.rocks

# FILL ME: public HTTPS URL of the tunnel that fronts host port 6674.
# It must be a NAMED cloudflared tunnel or a reserved ngrok domain. A
# trycloudflare quick tunnel changes hostname on every restart, and the data
# providers push to whatever URL is stored on-chain, so a rotated hostname
# leaves the machine stuck at INITIALIZED with a dead address registered.
# After any rotation: update this value, re-run use-chain.sh, then post-build.
EXT_PROXY_URL=

# --- Docker -----------------------------------------------------------------
# Build date used for reproducible images. The extension image installs apt
# packages from a snapshot.debian.org snapshot named after this timestamp, so it
# must be a real date. start-services.sh otherwise derives it from git and falls
# back to 0, which asks apt for a 1969 snapshot and fails the build with exit
# 100. Pinned to 2026-08-01T00:00:00Z.
SOURCE_DATE_EPOCH=1785542400

# REGISTRY=registry.gitlab.com/flarenetwork/tee/e2e

# Extension language: go | python | typescript (selects the Dockerfile built).
LANGUAGE=typescript
